<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Teste: Plus vs Flash — Análise de Solo — Doutor Café</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{ --verde:#1a5c2a; --verde-claro:#2d8a3e; --marrom:#3d2b1a; --cinza:#7a8a7c; --creme:#f5f0e8; }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'DM Sans',sans-serif;background:var(--creme);color:var(--marrom);padding:20px;max-width:1200px;margin:0 auto;}
  h1{font-family:'Playfair Display',serif;font-size:24px;margin-bottom:6px;}
  p.sub{color:var(--cinza);font-size:14px;margin-bottom:20px;}
  .campo{margin-bottom:14px;}
  label{display:block;font-size:12.5px;font-weight:700;color:var(--verde);margin-bottom:5px;}
  input[type=text]{width:100%;padding:10px 12px;border:1.5px solid #ddd3c2;border-radius:10px;font-size:14px;font-family:'DM Sans',sans-serif;}
  .check{display:flex;align-items:center;gap:8px;margin-bottom:14px;font-size:13px;}
  .check input{width:18px;height:18px;}
  .dropzone{border:2px dashed #c9bda3;border-radius:14px;padding:28px;text-align:center;background:white;cursor:pointer;margin-bottom:14px;}
  .dropzone.ativo{border-color:var(--verde-claro);background:#f2f8f3;}
  .dropzone img{max-width:100%;max-height:220px;border-radius:10px;margin-top:10px;}
  button{width:100%;padding:14px;background:linear-gradient(135deg,#2d8a3e,#1a5c2a);color:white;border:none;border-radius:12px;font-weight:700;font-size:15px;cursor:pointer;font-family:'DM Sans',sans-serif;}
  button:disabled{opacity:0.5;cursor:not-allowed;}
  .veredito{margin-top:22px;padding:16px;border-radius:14px;background:white;border:2px solid #eee2cf;display:none;}
  .veredito h2{font-family:'Playfair Display',serif;font-size:18px;margin-bottom:10px;}
  .veredito.ok{border-color:#2d8a3e;background:#f2f8f3;}
  .veredito.falha{border-color:#c9303f;background:#fdf3f3;}
  .linha-diff{display:flex;justify-content:space-between;font-size:13px;padding:6px 0;border-top:1px solid #f0e9dc;gap:10px;}
  .linha-diff:first-of-type{border-top:none;}
  .linha-diff .campo-nome{font-weight:700;min-width:110px;}
  .linha-diff .vals{text-align:right;flex:1;}
  .bate{color:#2d8a3e;font-weight:700;}
  .nbate{color:#c9303f;font-weight:700;}
  .resultados{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px;}
  @media (max-width:950px){.resultados{grid-template-columns:1fr;}}
  .card{background:white;border-radius:14px;padding:16px;border:1.5px solid #eee2cf;}
  .card h3{font-family:'Playfair Display',serif;font-size:15px;margin-bottom:10px;}
  .card.sonnet h3{color:#7a4413;}
  .card.plus h3{color:#c9303f;}
  .card.flash h3{color:#1a5c8a;}
  .card.oculto{display:none;}
  .status{font-size:12px;color:var(--cinza);margin-bottom:10px;}
  .metrica{display:flex;justify-content:space-between;font-size:13px;padding:5px 0;border-top:1px solid #f0e9dc;gap:8px;}
  .metrica:first-of-type{border-top:none;}
  .metrica b{color:var(--marrom);text-align:right;}
  table.valores{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:10px;}
  table.valores th{text-align:left;background:#faf6ee;padding:5px 6px;font-size:11px;color:var(--cinza);}
  table.valores td{padding:5px 6px;border-top:1px solid #f0e9dc;}
  .status-ok{color:#2d8a3e;font-weight:700;}
  .status-baixo{color:#c9303f;font-weight:700;}
  .status-alto{color:#c98a30;font-weight:700;}
  pre{font-size:11px;background:#faf6ee;padding:10px;border-radius:8px;margin-top:10px;max-height:200px;overflow:auto;white-space:pre-wrap;word-break:break-word;}
  .aviso{background:#fff8e1;border:1px solid #ffe0a3;border-radius:10px;padding:10px 12px;font-size:12.5px;color:#7a4a00;margin-bottom:18px;}
</style>
</head>
<body>

<h1>🧪 Plus vs Flash — Análise de Solo</h1>
<p class="sub">Compara o Qwen3.7-Plus (produção hoje) com o Qwen3.7-Flash (candidato, ~13x mais barato). O card da Sonnet é opcional e serve como gabarito externo. O que decide a troca são os <b>valores_calculo</b> — eles alimentam a calculadora de calagem.</p>

<div class="aviso">⚠️ O card "Plus" chama o endpoint de PRODUÇÃO (/analise-solo) — conta como uso real, mas não consome análises do usuário porque manda userId "anonimo". Os cards Sonnet e Flash usam endpoints isolados de teste.</div>

<div class="campo">
  <label>URL do backend</label>
  <input type="text" id="baseUrl" value="https://doutor-cafe-production.up.railway.app">
</div>
<div class="campo">
  <label>Região (opcional)</label>
  <input type="text" id="regiao" placeholder="ex: Mogiana">
</div>
<div class="campo">
  <label>Produtividade esperada em sacas/ha (opcional, só afeta cálculo de NPK)</label>
  <input type="text" id="produtividade" placeholder="ex: 40">
</div>

<div class="check">
  <input type="checkbox" id="usarSonnet">
  <label for="usarSonnet" style="margin:0;font-weight:500;color:var(--marrom);">Incluir a Sonnet como gabarito externo (chamada cara — deixe desmarcado nas rodadas de rotina)</label>
</div>

<div class="dropzone" id="dropzone">
  <span id="dropTexto">📷 Toque para escolher a foto do laudo, ou arraste aqui</span>
  <input type="file" id="fileInput" accept="image/*" style="display:none">
  <img id="preview" style="display:none">
</div>

<button id="btnComparar" disabled>Comparar</button>

<div class="veredito" id="veredito"></div>

<div class="resultados" id="resultados" style="display:none">
  <div class="card sonnet" id="cardSonnet">
    <h3>🔶 Sonnet (gabarito)</h3>
    <div class="status" id="statusSonnet">Aguardando...</div>
    <div id="metricasSonnet"></div>
    <div id="tabelaSonnet"></div>
    <pre id="respostaSonnet"></pre>
  </div>
  <div class="card plus">
    <h3>🔴 Qwen3.7-Plus (produção)</h3>
    <div class="status" id="statusPlus">Aguardando...</div>
    <div id="metricasPlus"></div>
    <div id="tabelaPlus"></div>
    <pre id="respostaPlus"></pre>
  </div>
  <div class="card flash">
    <h3>🔵 Qwen3.7-Flash (candidato)</h3>
    <div class="status" id="statusFlash">Aguardando...</div>
    <div id="metricasFlash"></div>
    <div id="tabelaFlash"></div>
    <pre id="respostaFlash"></pre>
  </div>
</div>

<script>
var imagemBase64 = null, tipoImagem = null;
var dadosPlus = null, dadosFlash = null;

var dropzone = document.getElementById('dropzone');
var fileInput = document.getElementById('fileInput');
var preview = document.getElementById('preview');
var dropTexto = document.getElementById('dropTexto');
var btnComparar = document.getElementById('btnComparar');

dropzone.addEventListener('click', function(){ fileInput.click(); });
dropzone.addEventListener('dragover', function(e){ e.preventDefault(); dropzone.classList.add('ativo'); });
dropzone.addEventListener('dragleave', function(){ dropzone.classList.remove('ativo'); });
dropzone.addEventListener('drop', function(e){
  e.preventDefault(); dropzone.classList.remove('ativo');
  if(e.dataTransfer.files[0]) processarArquivo(e.dataTransfer.files[0]);
});
fileInput.addEventListener('change', function(e){
  if(e.target.files[0]) processarArquivo(e.target.files[0]);
});

// Redimensionamento igual ao app de producao pra laudo de solo (1600px)
function redimensionarImagem(file, maxDim, qualidade, callback) {
  var leitor = new FileReader();
  leitor.onload = function(e) {
    var img = new Image();
    img.onload = function() {
      var w = img.width, h = img.height;
      if (w > maxDim || h > maxDim) {
        if (w >= h) { h = Math.round(h * maxDim / w); w = maxDim; }
        else { w = Math.round(w * maxDim / h); h = maxDim; }
      }
      var canvas = document.createElement("canvas");
      canvas.width = w; canvas.height = h;
      var ctx = canvas.getContext("2d");
      ctx.drawImage(img, 0, 0, w, h);
      var b64;
      try { b64 = canvas.toDataURL("image/jpeg", qualidade).split(",")[1]; }
      catch(err) { b64 = e.target.result.split(",")[1]; }
      callback(b64);
    };
    img.onerror = function() { callback(e.target.result.split(",")[1]); };
    img.src = e.target.result;
  };
  leitor.onerror = function() { callback(null); };
  leitor.readAsDataURL(file);
}

function processarArquivo(file){
  tipoImagem = 'image/jpeg';
  var reader = new FileReader();
  reader.onload = function(e){
    preview.src = e.target.result;
    preview.style.display = 'block';
  };
  reader.readAsDataURL(file);

  dropTexto.textContent = '⏳ Redimensionando (igual ao app)...';
  btnComparar.disabled = true;
  redimensionarImagem(file, 1600, 0.90, function(b64){
    imagemBase64 = b64;
    dropTexto.textContent = '✅ ' + file.name + ' (redimensionada p/ 1600px, igual ao app)';
    btnComparar.disabled = false;
  });
}

function buildTabelaValores(valores){
  if(!valores) return '';
  var linhas = Object.keys(valores).map(function(k){
    var v = valores[k];
    if(!v) return '';
    var statusClass = v.status==='ok'?'status-ok':v.status==='baixo'?'status-baixo':v.status==='alto'?'status-alto':'';
    return '<tr><td><b>'+k+'</b></td><td>'+(v.valor!==undefined&&v.valor!==null?v.valor:'-')+'</td><td class="'+statusClass+'">'+(v.status||'-')+'</td></tr>';
  }).join('');
  return '<table class="valores"><tr><th>Campo</th><th>Valor</th><th>Status</th></tr>'+linhas+'</table>';
}

function buildTabelaCalculo(vc){
  if(!vc) return '';
  var linhas = Object.keys(vc).map(function(k){
    return '<tr><td><b>'+k+'</b></td><td>'+(vc[k]!==undefined&&vc[k]!==null?vc[k]:'null')+'</td></tr>';
  }).join('');
  return '<table class="valores"><tr><th colspan="2">valores_calculo (brutos do laudo)</th></tr>'+linhas+'</table>';
}

// normaliza pra comparar: "6,1" e 6.1 e " 6.10 " sao o mesmo numero
function norm(v){
  if(v===undefined||v===null||v==='') return null;
  var s = String(v).trim().replace(',', '.');
  var n = parseFloat(s);
  if(!isNaN(n) && isFinite(n)) return n;
  return s.toLowerCase();
}

function montarVeredito(){
  var el = document.getElementById('veredito');
  if(!dadosPlus || !dadosFlash){ el.style.display='none'; return; }

  var vcP = dadosPlus.valores_calculo || {};
  var vcF = dadosFlash.valores_calculo || {};
  var campos = ['ca_cmolc','mg_cmolc','k_cmolc','al_cmolc','t_cmolc','ctc_efetiva_cmolc','argila_pct'];

  var html = '<h2>Veredito — valores_calculo (o que alimenta a calagem)</h2>';
  var divergencias = 0;
  campos.forEach(function(c){
    var a = norm(vcP[c]), b = norm(vcF[c]);
    var igual = (a === b);
    if(!igual) divergencias++;
    html += '<div class="linha-diff"><span class="campo-nome">'+c+'</span>'+
            '<span class="vals">Plus: <b>'+(vcP[c]===undefined||vcP[c]===null?'null':vcP[c])+'</b> &nbsp;|&nbsp; '+
            'Flash: <b>'+(vcF[c]===undefined||vcF[c]===null?'null':vcF[c])+'</b> '+
            '<span class="'+(igual?'bate':'nbate')+'">'+(igual?'✓':'✗')+'</span></span></div>';
  });

  // valores exibidos ao usuario
  var vP = dadosPlus.valores || {}, vF = dadosFlash.valores || {};
  var chavesV = Object.keys(vP);
  var divV = 0;
  html += '<h2 style="margin-top:14px;">Valores exibidos (pH, MO, P...)</h2>';
  chavesV.forEach(function(k){
    var pv = vP[k]||{}, fv = vF[k]||{};
    var igualValor  = norm(pv.valor) === norm(fv.valor);
    var igualStatus = norm(pv.status) === norm(fv.status);
    var igual = igualValor && igualStatus;
    if(!igual) divV++;
    html += '<div class="linha-diff"><span class="campo-nome">'+k+'</span>'+
            '<span class="vals">Plus: <b>'+(pv.valor||'-')+' / '+(pv.status||'-')+'</b> &nbsp;|&nbsp; '+
            'Flash: <b>'+(fv.valor||'-')+' / '+(fv.status||'-')+'</b> '+
            '<span class="'+(igual?'bate':'nbate')+'">'+(igual?'✓':'✗')+'</span></span></div>';
  });

  var aprovado = (divergencias === 0);
  el.className = 'veredito ' + (aprovado ? 'ok' : 'falha');
  var resumo = aprovado
    ? '<p style="margin-bottom:10px;color:#1a5c2a;font-weight:700;">✅ Nesta foto os valores_calculo bateram 100%. '+(divV>0?('Houve '+divV+' divergência(s) nos valores exibidos — vale olhar, mas não bloqueia.'):'Valores exibidos também bateram.')+'</p>'
    : '<p style="margin-bottom:10px;color:#c9303f;font-weight:700;">❌ '+divergencias+' divergência(s) em valores_calculo. Isso muda a dose de calcário/gesso — reprovado nesta foto.</p>';
  el.innerHTML = resumo + html + '<p style="margin-top:12px;font-size:12px;color:#7a8a7c;">Uma foto não decide nada. Rode pelo menos 4-5 laudos diferentes antes de concluir.</p>';
  el.style.display = 'block';
}

btnComparar.addEventListener('click', async function(){
  var baseUrl = document.getElementById('baseUrl').value.replace(/\/$/,'');
  var regiao = document.getElementById('regiao').value || null;
  var produtividade = document.getElementById('produtividade').value || null;
  var usarSonnet = document.getElementById('usarSonnet').checked;

  dadosPlus = null; dadosFlash = null;
  document.getElementById('veredito').style.display = 'none';
  document.getElementById('resultados').style.display = 'grid';
  document.getElementById('cardSonnet').className = 'card sonnet' + (usarSonnet ? '' : ' oculto');
  btnComparar.disabled = true;

  if(usarSonnet){
    btnComparar.textContent = 'Testando Sonnet...';
    await rodarSonnet(baseUrl, regiao);
  }

  btnComparar.textContent = 'Testando Plus (produção)...';
  await rodarPlus(baseUrl, regiao, produtividade);

  btnComparar.textContent = 'Testando Flash (candidato)...';
  await rodarFlash(baseUrl, regiao);

  montarVeredito();

  btnComparar.disabled = false;
  btnComparar.textContent = 'Comparar';
});

function metricasHTML(data, usage){
  var custoTexto = data.custo_usd_estimado!=null
    ? ('US$ ' + data.custo_usd_estimado.toFixed(6) + ' (R$ ' + data.custo_brl_estimado.toFixed(5) + ')')
    : '-';
  var u = usage || {};
  return '<div class="metrica"><span>Custo estimado</span><b>' + custoTexto + '</b></div>' +
         '<div class="metrica"><span>Entrada / saída</span><b>' + (u.input_tokens!=null?u.input_tokens:'-') + ' / ' + (u.output_tokens!=null?u.output_tokens:'-') + '</b></div>' +
         '<div class="metrica"><span>Cache leitura / escrita</span><b>' + (u.cache_read_input_tokens||0) + ' / ' + (u.cache_creation_input_tokens||0) + '</b></div>';
}

function rodarSonnet(baseUrl, regiao){
  document.getElementById('statusSonnet').textContent = '⏳ Consultando...';
  var inicio = Date.now();
  return fetch(baseUrl + '/teste-solo-sonnet', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ imagem: imagemBase64, tipo: tipoImagem, regiao: regiao })
  })
  .then(function(r){ return r.json(); })
  .then(function(data){
    var duracao = ((Date.now() - inicio)/1000).toFixed(1);
    document.getElementById('statusSonnet').textContent = '✅ ' + duracao + 's';
    document.getElementById('metricasSonnet').innerHTML = metricasHTML(data, data.usage);
    if(data.resultado_parseado){
      document.getElementById('tabelaSonnet').innerHTML =
        buildTabelaValores(data.resultado_parseado.valores) +
        buildTabelaCalculo(data.resultado_parseado.valores_calculo);
    }
    document.getElementById('respostaSonnet').textContent = JSON.stringify(data.resultado_parseado||data, null, 2);
  })
  .catch(function(e){
    document.getElementById('statusSonnet').textContent = '❌ Erro: ' + e.message;
  });
}

function rodarPlus(baseUrl, regiao, produtividade){
  document.getElementById('statusPlus').textContent = '⏳ Consultando (produção)...';
  var inicio = Date.now();
  var body = { imagem: imagemBase64, tipo: tipoImagem, userId: 'anonimo', regiao: regiao };
  if(produtividade) body.produtividadeSc = produtividade;
  return fetch(baseUrl + '/analise-solo', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify(body)
  })
  .then(function(r){ return r.json(); })
  .then(function(data){
    var duracao = ((Date.now() - inicio)/1000).toFixed(1);
    document.getElementById('statusPlus').textContent = '✅ ' + duracao + 's (endpoint de produção)';
    dadosPlus = data;
    document.getElementById('metricasPlus').innerHTML =
      '<div class="metrica"><span>Custo / tokens</span><b>não expostos pelo /analise-solo</b></div>';
    document.getElementById('tabelaPlus').innerHTML =
      buildTabelaValores(data.valores) + buildTabelaCalculo(data.valores_calculo);
    document.getElementById('respostaPlus').textContent = JSON.stringify(data, null, 2);
  })
  .catch(function(e){
    document.getElementById('statusPlus').textContent = '❌ Erro: ' + e.message;
  });
}

function rodarFlash(baseUrl, regiao){
  document.getElementById('statusFlash').textContent = '⏳ Consultando...';
  var inicio = Date.now();
  return fetch(baseUrl + '/teste-solo-flash', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ imagem: imagemBase64, tipo: tipoImagem, regiao: regiao })
  })
  .then(function(r){ return r.json(); })
  .then(function(data){
    var duracao = ((Date.now() - inicio)/1000).toFixed(1);
    document.getElementById('statusFlash').textContent = '✅ ' + duracao + 's';
    dadosFlash = data.resultado_parseado || {};
    document.getElementById('metricasFlash').innerHTML = metricasHTML(data, data.usage);
    if(data.resultado_parseado){
      document.getElementById('tabelaFlash').innerHTML =
        buildTabelaValores(data.resultado_parseado.valores) +
        buildTabelaCalculo(data.resultado_parseado.valores_calculo);
    }
    document.getElementById('respostaFlash').textContent = JSON.stringify(data.resultado_parseado||data, null, 2);
  })
  .catch(function(e){
    document.getElementById('statusFlash').textContent = '❌ Erro: ' + e.message;
  });
}
</script>

</body>
</html>
